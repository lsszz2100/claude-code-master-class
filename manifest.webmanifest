{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Claude Code 마스터 클래스",
  "short_name": "ClaudeCode",
  "description": "한국어 Claude Code 종합 실전 강의 — 설치부터 루프 엔지니어링까지 18개 챕터 완벽 마스터",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e0f13",
  "theme_color": "#0e0f13",
  "lang": "ko-KR",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/og.png",
      "sizes": "1200x630",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "categories": ["education", "developer", "productivity"]
}
