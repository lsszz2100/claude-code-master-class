# Vercel (프로젝트 식별자 · OIDC 토큰)
.vercel

# 환경 변수 — 절대 커밋 금지
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node — 슬래시를 붙이면 심볼릭 링크로 걸어 둔 node_modules 를 못 잡는다
node_modules

# 검증 스크립트 산출물
shot-*.png
f[0-9][0-9]-*.png

# prerender.mjs 가 챕터 높이를 잴 때 쓰는 임시 파일 (정상 종료 시 스스로 지운다)
.cv-measure.html

# OS
.DS_Store
Thumbs.db
desktop.ini

# 자격 증명
.ghtoken
*.token
*credentials*
