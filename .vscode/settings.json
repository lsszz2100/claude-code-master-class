{
  // index.html 은 build_course.py + tools/prerender.mjs 가 만드는 빌드 산출물이다.
  // 저장 시 자동 포맷이 걸리면 내용은 그대로인 채 804KB -> 1.1MB 로 부풀고
  // 2만 줄짜리 의미 없는 diff 가 생긴다. 이 저장소의 HTML 은 전부 산출물이므로 통째로 끈다.
  "[html]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.formatOnType": false,
    "editor.trimAutoWhitespace": false
  },
  "html.format.enable": false,

  // 산출물을 실수로 열어 편집하지 않도록 읽기 전용으로 연다.
  // 고칠 곳은 build_course.py 또는 content/*.md 다.
  "files.readonlyInclude": {
    "index.html": true,
    "sitemap.xml": true
  },

  "files.eol": "\n",
  "files.exclude": {
    "**/.cv-measure.html": true
  }
}
